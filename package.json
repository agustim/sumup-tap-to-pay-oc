{
  "name": "sumup-tap-to-pay-oc",
  "version": "0.1.0",
  "description": "Capacitor plugin: SumUp Tap to Pay (phone as card terminal)",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/"
  ],
  "author": "Agustí Moll <amoll@omnium.cat>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agustim/sumup-tap-to-pay-oc.git"
  },
  "bugs": {
    "url": "https://github.com/agustim/sumup-tap-to-pay-oc/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "sumup",
    "tap-to-pay",
    "nfc"
  ],
  "scripts": {
    "verify:web": "npm run build",
    "docgen": "docgen --api SumUpTapToPayPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.js",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/docgen": "^0.0.18",
    "rimraf": "^3.0.2",
    "rollup": "^2.32.0",
    "typescript": "~4.1.5"
  },
  "peerDependencies": {
    "@capacitor/core": "^5.0.0"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  }
}
